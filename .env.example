# ── Provider ──
# ollama-local | ollama-cloud
LLM_PROVIDER=ollama-local

# ── Ollama (local relay) ──
# Point at the local daemon; cloud models (e.g. deepseek-v4.1-flash:cloud)
# stream via ollama.com after `ollama signin`. The API key is ignored locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Models: deepseek-v4.1-flash:cloud · deepseek-v4-flash:0731-cloud · deepseek-v4-pro:cloud
LLM_MODEL=deepseek-v4.1-flash:cloud

# ── Ollama (direct ollama.com) ──
# Set these instead when using provider ollama-cloud:
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=<your ollama.com API key — https://ollama.com/settings/keys>
# LLM_MODEL=deepseek-v4.1-flash

# ── n8n MCP bridge ──
# Token from laptop-n8n-mcp/MCP_TOKEN.txt on the server
N8N_MCP_URL=http://localhost:5678/mcp-server/http
N8N_MCP_TOKEN=

# ── Agent behavior ──
MAX_TURNS=50
LOG_LEVEL=info
# Custom system prompt (optional, multiline via quoted value)
SYSTEM_PROMPT=You are an LLM-powered agent operating an n8n server through its MCP interface. Use the available tools to inspect, create, execute, and manage n8n workflows. Read the SDK reference before writing workflow code. Be concise and verify your work.
# Keep data: URLs (images) out of the model context
MCP_RESOLVE_IMAGE_DATA_URLS=false